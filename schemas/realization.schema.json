{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:realization:1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "compatibleDefinitionDigest",
    "requiredCapabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "cube-euclidean",
        "cube-port-diagram",
        "cube-spherical",
        "polyhedral-euclidean",
        "polyhedral-port-diagram",
        "polyhedral-spherical"
      ]
    },
    "compatibleDefinitionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "triangle-meshes",
          "rigid-transforms"
        ]
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "modelByDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "placementFrames": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/frame"
      }
    },
    "operationTracks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "axis",
          "fromStop",
          "toStop"
        ],
        "properties": {
          "axis": {
            "$ref": "#/$defs/point"
          },
          "fromStop": {
            "type": "integer",
            "minimum": 0
          },
          "toStop": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "angularStops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bodyInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.5
    },
    "stickerInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.5
    },
    "stickerLift": {
      "type": "number",
      "minimum": 0
    },
    "fidelity": {
      "type": "string"
    },
    "radius": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "diskAngleDegrees": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "angularSegments": {
      "type": "integer",
      "minimum": 16,
      "maximum": 128,
      "multipleOf": 4
    },
    "radialSegments": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "portInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.25
    },
    "surfaceLift": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "frame": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      }
    },
    "model": {
      "type": "object",
      "required": [
        "vertices",
        "ports",
        "symmetries"
      ],
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "surfaceVertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "symmetries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cube-spherical"
          }
        }
      },
      "then": {
        "required": [
          "radius",
          "diskAngleDegrees",
          "angularSegments",
          "radialSegments",
          "portInset",
          "surfaceLift"
        ],
        "properties": {
          "diskAngleDegrees": {
            "minimum": 55,
            "maximum": 85
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "polyhedral-euclidean",
              "polyhedral-port-diagram",
              "polyhedral-spherical"
            ]
          }
        }
      },
      "then": {
        "required": [
          "models",
          "modelByDomain",
          "placementFrames",
          "operationTracks",
          "angularStops",
          "scale",
          "bodyInset",
          "stickerInset",
          "stickerLift"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "polyhedral-spherical"
          }
        }
      },
      "then": {
        "required": [
          "radius",
          "diskAngleDegrees",
          "angularSegments",
          "radialSegments",
          "portInset",
          "surfaceLift"
        ]
      }
    }
  ]
}
