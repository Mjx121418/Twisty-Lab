{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:realization:1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "compatibleDefinitionDigest",
    "requiredCapabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "cube-euclidean",
        "cube-port-diagram",
        "cube-spherical",
        "polyhedral-euclidean",
        "polyhedral-port-diagram",
        "polyhedral-spherical",
        "articulated-euclidean",
        "articulated-port-diagram",
        "articulated-spherical",
        "flat-quotient"
      ]
    },
    "compatibleDefinitionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "triangle-meshes",
          "rigid-transforms",
          "quotient-surface",
          "quotient-orbifold",
          "shared-rotation-tracks",
          "family-rotation-generators",
          "transport-path-selectors"
        ]
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "modelByDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "placementFrames": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/frame"
      }
    },
    "operationTracks": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "axis",
              "fromStop",
              "toStop"
            ],
            "properties": {
              "axis": {
                "$ref": "#/$defs/point"
              },
              "fromStop": {
                "type": "integer",
                "minimum": 0
              },
              "toStop": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "$ref": "#/$defs/motionBinding"
          }
        ]
      }
    },
    "angularStops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bodyInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.5
    },
    "stickerInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.5
    },
    "stickerLift": {
      "type": "number",
      "minimum": 0
    },
    "fidelity": {
      "type": "string"
    },
    "radius": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "diskAngleDegrees": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "angularSegments": {
      "type": "integer",
      "minimum": 16,
      "maximum": 128,
      "multipleOf": 4
    },
    "radialSegments": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "portInset": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.25
    },
    "surfaceLift": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "required": [
          "vertices",
          "triangles"
        ],
        "properties": {
          "vertices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 65536,
            "items": {
              "$ref": "#/$defs/point"
            }
          },
          "radialNormalTriangles": {
            "description": "Triangle indices with smooth signed radial normals about the local origin, for any articulated realization kind.",
            "type": "array",
            "maxItems": 262144,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "triangles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 262144,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "componentsByDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "$ref": "#/$defs/component"
        }
      }
    },
    "flatSurface": {
      "type": "object",
      "required": [
        "topology",
        "sideLength"
      ],
      "additionalProperties": false,
      "properties": {
        "topology": {
          "enum": [
            "torus",
            "klein-bottle",
            "pillowcase",
            "orbifold-333"
          ]
        },
        "chart": {
          "enum": [
            "square",
            "rhombus-60",
            "pillowcase-square",
            "orbifold-333-rhombus"
          ]
        },
        "sideLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "cutRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diskCenters": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "rotationTracks": {
      "type": "object",
      "maxProperties": 8192,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/rotationStep"
            }
          },
          {
            "$ref": "#/$defs/motionBinding"
          }
        ]
      }
    },
    "operationTrackTables": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/operationTrackTable"
      }
    },
    "motionFamilies": {
      "type": "object",
      "required": [
        "version",
        "families"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "families": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "object",
            "required": [
              "axis",
              "pivot",
              "space",
              "coordinates"
            ],
            "additionalProperties": false,
            "properties": {
              "axis": {
                "$ref": "#/$defs/point"
              },
              "pivot": {
                "$ref": "#/$defs/point"
              },
              "space": {
                "enum": [
                  "world",
                  "local"
                ]
              },
              "coordinates": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 128,
                "additionalProperties": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },
    "controlLayout": {
      "type": "object",
      "required": [
        "version",
        "drivers"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "drivers": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "object",
            "required": [
              "angles"
            ],
            "additionalProperties": false,
            "properties": {
              "angles": {
                "type": "array",
                "minItems": 2,
                "maxItems": 128,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 6.283185307179587
                }
              }
            }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "frame": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      }
    },
    "model": {
      "type": "object",
      "required": [
        "vertices",
        "ports",
        "symmetries"
      ],
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "surfaceVertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "symmetries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "rigidFrame": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number"
      }
    },
    "rotationStep": {
      "type": "object",
      "required": [
        "axis",
        "pivot",
        "angle",
        "space"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/point"
        },
        "pivot": {
          "$ref": "#/$defs/point"
        },
        "angle": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "space": {
          "enum": [
            "world",
            "local"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "meshAssetId",
        "role",
        "placementFrames",
        "operationTracks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "meshAssetId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "body",
            "port"
          ]
        },
        "portId": {
          "type": "string",
          "minLength": 1
        },
        "placementFrames": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rigidFrame"
          }
        },
        "symmetries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rigidFrame"
          },
          "maxItems": 32
        },
        "operationTracks": {
          "oneOf": [
            {
              "$ref": "#/$defs/operationTrackTable"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "rotationPath": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/rotationStep"
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/motionBinding"
        }
      ]
    },
    "operationTrackTable": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/rotationPath"
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "regions"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "transport-regions"
              },
              "regions": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "request",
                    "path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "request": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "motionBinding": {
      "type": "object",
      "required": [
        "family",
        "from",
        "to",
        "winding"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "winding": {
          "type": "integer",
          "minimum": -16,
          "maximum": 16
        },
        "rate": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cube-spherical"
          }
        }
      },
      "then": {
        "required": [
          "radius",
          "diskAngleDegrees",
          "angularSegments",
          "radialSegments",
          "portInset",
          "surfaceLift"
        ],
        "properties": {
          "diskAngleDegrees": {
            "minimum": 55,
            "maximum": 85
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "polyhedral-euclidean",
              "polyhedral-port-diagram",
              "polyhedral-spherical"
            ]
          }
        }
      },
      "then": {
        "required": [
          "models",
          "modelByDomain",
          "placementFrames",
          "operationTracks",
          "angularStops",
          "scale",
          "bodyInset",
          "stickerInset",
          "stickerLift"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "polyhedral-spherical"
          }
        }
      },
      "then": {
        "required": [
          "radius",
          "diskAngleDegrees",
          "angularSegments",
          "radialSegments",
          "portInset",
          "surfaceLift"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "articulated-euclidean",
              "articulated-port-diagram",
              "articulated-spherical"
            ]
          }
        }
      },
      "then": {
        "required": [
          "assets",
          "componentsByDomain"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "articulated-spherical"
          }
        }
      },
      "then": {
        "required": [
          "radius"
        ],
        "properties": {
          "radius": {
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "flat-quotient"
          }
        }
      },
      "then": {
        "required": [
          "flatSurface",
          "assets",
          "componentsByDomain"
        ],
        "properties": {
          "requiredCapabilities": {
            "contains": {
              "const": "quotient-surface"
            }
          }
        }
      }
    }
  ]
}
