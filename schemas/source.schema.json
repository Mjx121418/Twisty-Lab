{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:source:1",
  "type": "object",
  "required": ["schemaVersion", "semanticsVersion", "kind", "puzzleId", "group", "prototypes", "operationPrototype", "bandage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "semanticsVersion": {"type": "string", "minLength": 1},
    "kind": {"const": "cube-prototypes"},
    "puzzleId": {"type": "string", "minLength": 1},
    "bandage": {"type": "boolean"},
    "group": {
      "type": "object", "required": ["generators", "limit"],
      "properties": {
        "generators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/permutation"}},
        "limit": {"type": "integer", "minimum": 1, "maximum": 65536},
        "subgroupGenerators": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/permutation"}}}
      }
    },
    "prototypes": {
      "type": "object", "required": ["corner", "edge", "center"],
      "properties": {"corner": {"$ref": "#/$defs/prototype"}, "edge": {"$ref": "#/$defs/prototype"}, "center": {"$ref": "#/$defs/prototype"}}
    },
    "operationPrototype": {
      "type": "object", "required": ["supportFace", "permutation"],
      "properties": {"supportFace": {"$ref": "#/$defs/face"}, "permutation": {"$ref": "#/$defs/permutation"}}
    }
  },
  "$defs": {
    "face": {"enum": ["U", "R", "F", "D", "L", "B"]},
    "permutation": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 5}},
    "prototype": {"type": "object", "required": ["faces"], "properties": {"faces": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/face"}}}}
  }
}
