{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:session:3",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "logical",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "session"
    },
    "presentation": {
      "type": "object"
    },
    "logical": {
      "type": "object",
      "required": [
        "executionDigest",
        "originState",
        "requests",
        "cursor",
        "revision",
        "stateDigest",
        "checkpoints"
      ],
      "properties": {
        "executionDigest": {
          "$ref": "urn:twisty:schema:state:1#/$defs/digest"
        },
        "originState": {
          "$ref": "urn:twisty:schema:state:1#/$defs/state"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "stateDigest": {
          "$ref": "urn:twisty:schema:state:1#/$defs/digest"
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "operation",
              "parameters",
              "afterStateDigest",
              "choices"
            ],
            "properties": {
              "operation": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "maxProperties": 0
              },
              "afterStateDigest": {
                "$ref": "urn:twisty:schema:state:1#/$defs/digest"
              },
              "choices": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "state",
              "stateDigest"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "$ref": "urn:twisty:schema:state:1#/$defs/state"
              },
              "stateDigest": {
                "$ref": "urn:twisty:schema:state:1#/$defs/digest"
              }
            }
          }
        }
      }
    }
  },
  "description": "Relational history: every request records its complete movement tuple."
}
