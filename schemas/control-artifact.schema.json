{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"urn:twisty:schema:controls:1",
  "type":"object","additionalProperties":false,
  "required":["kind","contractVersion","executionDigest","controlDigest","catalog"],
  "properties":{
    "kind":{"const":"twisty-controls"},"contractVersion":{"const":1},
    "executionDigest":{"$ref":"#/definitions/digest"},"controlDigest":{"$ref":"#/definitions/digest"},
    "catalog":{
      "type":"object","additionalProperties":false,"required":["version","drivers","families"],
      "properties":{
        "version":{"const":1},
        "drivers":{"type":"array","maxItems":128,"items":{
          "type":"object","additionalProperties":false,"required":["id","piece","stops","reader"],
          "properties":{
            "id":{"$ref":"#/definitions/id"},"piece":{"$ref":"#/definitions/index"},
            "stops":{"type":"array","minItems":2,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/definitions/id"}},
            "reader":{"type":"array","minItems":1,"maxItems":1000000,"items":{
              "type":"object","additionalProperties":false,"required":["placement","stop"],
              "properties":{"placement":{"$ref":"#/definitions/index"},"stop":{"$ref":"#/definitions/index"}}
            }}
          }
        }},
        "families":{"type":"array","maxItems":256,"items":{
          "type":"object","additionalProperties":false,"required":["id","drivers","routes"],
          "properties":{
            "id":{"$ref":"#/definitions/id"},"label":{"$ref":"#/definitions/id"},
            "drivers":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/definitions/id"}},
            "routes":{"type":"array","maxItems":131072,"items":{
              "type":"object","additionalProperties":false,"required":["from","to","request","profile","pathId"],
              "properties":{
                "from":{"$ref":"#/definitions/stops"},"to":{"$ref":"#/definitions/stops"},
                "request":{"$ref":"#/definitions/id"},"profile":{"$ref":"#/definitions/id"},
                "pathId":{"$ref":"#/definitions/id"},"preferred":{"type":"boolean"}
              }
            }}
          }
        }}
      }
    }
  },
  "definitions":{
    "id":{"type":"string","minLength":1,"maxLength":256},
    "index":{"type":"integer","minimum":0,"maximum":4294967294},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stops":{"type":"array","minItems":1,"maxItems":2,"items":{"$ref":"#/definitions/id"}}
  }
}
