{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:relational-package:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "formatVersion",
    "source",
    "catalog"
  ],
  "properties": {
    "kind": {
      "const": "relational-package"
    },
    "formatVersion": {
      "const": 1
    },
    "source": {
      "$ref": "urn:twisty:schema:relational-puzzle:1"
    },
    "catalog": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "puzzleId",
        "domains",
        "pieces",
        "placements",
        "requests",
        "resources"
      ],
      "properties": {
        "kind": {
          "enum": [
            "relational-cube-bindings",
            "relational-port-bindings",
            "relational-articulated-bindings"
          ]
        },
        "version": {
          "const": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "relational-cube-bindings"
              }
            }
          },
          "then": {
            "required": [
              "symmetry",
              "faceLabels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "relational-articulated-bindings"
              }
            }
          },
          "then": {
            "required": [
              "events",
              "moveInverses"
            ]
          }
        }
      ]
    }
  }
}
