{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:schema:fixture:1",
  "type": "object", "required": ["schemaVersion", "kind", "cases"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "regression-fixtures"},
    "cases": {"type": "array", "items": {
      "type": "object", "required": ["name", "source", "definitionDigest", "prefix", "operation", "expectedStatus"],
      "properties": {
        "name": {"type": "string"}, "source": {"type": "string"},
        "definitionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prefix": {"type": "string"}, "operation": {"type": "string"},
        "expectedStatus": {"enum": ["Committed", "Blocked"]}, "reasonCode": {"type": "string"},
        "implicatedPiece": {"type": "string"}, "unchangedParticipant": {"type": "string"}
      }
    }}
  }
}
