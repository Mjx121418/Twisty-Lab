{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:twisty:draft:contract-common:1",
  "description": "Phase-1 draft only. Structural validation does not certify references, hashes, or geometry.",
  "definitions": {
    "index": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
    "indices": { "type": "array", "maxItems": 4000000, "items": { "$ref": "#/definitions/index" } },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
    "ids": { "type": "array", "maxItems": 1000000, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024,
          "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    }
  }
}
